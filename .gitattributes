# Keep Linux device scripts portable across developer workstations.
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.md text eol=lf

# Unified diff context deliberately has a space before source indentation.
*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
